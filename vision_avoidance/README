To transfer:
ros2 pkg create vision_avoidance --build-type ament_python --dependencies rclpy geometry_msgs nav_msgs sensor_msgs cv_bridge
scp -r /home/aran/Rover/vision_avoidance pi@10.0.0.1:/home/pi/ros_ws/src

To Run:

Terminal 1:
colcon build --symlink-install --packages-select vision_avoidance
source install/setup.bash
ros2 run vision_avoidance vision_navigate_server

Terminal 2:
colcon build --symlink-install --packages-select vision_avoidance
source install/setup.bash
ros2 action send_goal /vision_navigate go_to_interfaces/action/VisionNavigate "{target_x: -4.69, target_y: -2.16, max_speed: 1.0}" --feedback